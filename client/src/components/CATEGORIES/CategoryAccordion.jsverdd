// 📂 components/CATEGORIES/CategoryAccordion.jsx
import React, { useState, useEffect, useMemo, useCallback } from 'react';
import { useSelector, useDispatch } from 'react-redux';
import { motion, AnimatePresence } from 'framer-motion';
import { Card, Spinner, Alert, Button } from 'react-bootstrap';
import { getCategoriesForAccordion } from '../../redux/actions/categoryAction';

const CategoryAccordion = ({ 
  postData = {}, 
  handleChangeInput,
  onFieldChange,
  disabled = false
}) => {
  const dispatch = useDispatch();
  const [searchTerm, setSearchTerm] = useState('');
  const [expandedItems, setExpandedItems] = useState({});
  const [selectedPath, setSelectedPath] = useState([]);
  const [isMobile, setIsMobile] = useState(false);
  const [isInitialized, setIsInitialized] = useState(false);

  // 🔄 DEBUG: Mostrar props recibidos
  useEffect(() => {
    console.log('🟢 CategoryAccordion - Props recibidos:', {
      postData,
      hasHandleChangeInput: !!handleChangeInput,
      hasOnFieldChange: !!onFieldChange,
      disabled
    });
  }, [postData, handleChangeInput, onFieldChange, disabled]);

  // 🔄 Obtener categorías específicas para accordion desde Redux
  const { 
    accordionCategories = [],
    accordionLoading = false,
    accordionError = null
  } = useSelector((state) => ({
    accordionCategories: state.category?.accordionCategories || [],
    accordionLoading: state.category?.accordionLoading || false,
    accordionError: state.category?.accordionError || null
  }));

  // 🔄 Detectar si es móvil
  useEffect(() => {
    const checkMobile = () => setIsMobile(window.innerWidth < 768);
    checkMobile();
    window.addEventListener('resize', checkMobile);
    return () => window.removeEventListener('resize', checkMobile);
  }, []);

  // 🔄 Cargar categorías al montar el componente
  useEffect(() => {
    console.log('🔄 CategoryAccordion - Iniciando carga de categorías...');
    if (accordionCategories.length === 0 && !accordionLoading) {
      console.log('📡 Dispatch getCategoriesForAccordion');
      dispatch(getCategoriesForAccordion())
        .then(result => {
          console.log('✅ Categorías cargadas:', result.success ? 'Éxito' : 'Error');
        });
    }
  }, [dispatch, accordionCategories.length, accordionLoading]);

  // 🔄 INICIALIZAR CON POSTDATA EXISTENTE
  useEffect(() => {
    if (!accordionLoading && accordionCategories.length > 0 && postData && !isInitialized) {
      console.log('🔄 Inicializando con postData:', postData);
      
      const findPath = (categories, path = [], target) => {
        for (const cat of categories) {
          const currentPath = [...path, cat];
          
          console.log(`🔍 Comparando "${cat.name}" con:`, {
            categorie: target.categorie,
            subCategory: target.subCategory,
            articleType: target.articleType
          });
          
          const matches = 
            cat.name === target.categorie || 
            cat.name === target.subCategory || 
            cat.name === target.articleType;
          
          if (matches) {
            console.log(`✅ Coincidencia encontrada: ${cat.name}`);
            
            if (!cat.children || cat.children.length === 0) {
              console.log('🎯 Categoría final encontrada');
              return currentPath;
            }
            
            if (cat.children) {
              const found = findPath(cat.children, currentPath, target);
              if (found) {
                console.log('✅ Encontrado en hijos');
                return found;
              }
            }
          }
          
          if (cat.children) {
            const found = findPath(cat.children, currentPath, target);
            if (found) return found;
          }
        }
        return null;
      };

      if (postData.categorie || postData.subCategory || postData.articleType) {
        console.log('🎯 Buscando ruta con datos existentes...');
        const foundPath = findPath(accordionCategories, [], postData);
        
        if (foundPath) {
          console.log('✅ Ruta encontrada:', foundPath.map(c => c.name));
          setSelectedPath(foundPath);
          
          const expanded = {};
          for (let i = 0; i < foundPath.length - 1; i++) {
            expanded[foundPath[i]._id] = true;
          }
          setExpandedItems(expanded);
        } else {
          console.warn('⚠️ No se encontró ruta para:', postData);
        }
      } else {
        console.log('📭 No hay datos de categoría en postData');
      }
      
      setIsInitialized(true);
    }
  }, [accordionCategories, accordionLoading, postData, isInitialized]);

  // 🔄 Manejar clic en categoría
  const handleCategoryClick = useCallback((category, path = []) => {
    if (disabled || !category) {
      console.log('⏸️ Clic ignorado (disabled o categoría nula)');
      return;
    }
    
    console.log('🖱️ Categoría clickeada:', category.name, 'Path:', path.map(p => p.name));
    
    const currentPath = [...path, category];
    
    if (category.children?.length > 0) {
      console.log('📂 Expandir/colapsar categoría con hijos');
      setExpandedItems(prev => ({
        ...prev,
        [category._id]: !prev[category._id]
      }));
    } else {
      console.log('✅ Seleccionando categoría final');
      handleCategorySelection(category, currentPath);
    }
  }, [disabled]);

  // 🔄 Seleccionar categoría
  const handleCategorySelection = useCallback((category, path) => {
    if (!category) {
      console.error('❌ Categoría nula en handleCategorySelection');
      return;
    }
    
    const updates = {};
    if (path.length >= 1) updates.categorie = path[0].name;
    if (path.length >= 2) updates.subCategory = path[1].name;
    if (path.length >= 3) updates.articleType = path[2].name;
    
    console.log('🔴 CategoryAccordion - handleCategorySelection:', {
      path: path.map(p => p.name),
      updates,
      hasHandleChangeInput: !!handleChangeInput,
      hasOnFieldChange: !!onFieldChange
    });
    
    // Verificar que tenemos al menos un handler
    if (!handleChangeInput && !onFieldChange) {
      console.error('❌ ERROR: No hay handlers disponibles');
      alert('Error: No se pueden actualizar los campos. Por favor recarga la página.');
      return;
    }
    
    // Enviar actualizaciones
    Object.entries(updates).forEach(([field, value]) => {
      console.log(`🔄 Procesando campo ${field} = ${value}`);
      
      // Método 1: handleChangeInput (evento sintético)
      if (handleChangeInput) {
        console.log(`📤 Llamando handleChangeInput para ${field}`);
        try {
          const syntheticEvent = {
            target: {
              name: field,
              value: value
            }
          };
          handleChangeInput(syntheticEvent);
          console.log(`✅ handleChangeInput llamado exitosamente para ${field}`);
        } catch (error) {
          console.error(`❌ Error en handleChangeInput para ${field}:`, error);
        }
      }
      
      // Método 2: onFieldChange (directo)
      if (onFieldChange) {
        console.log(`📤 Llamando onFieldChange para ${field}`);
        try {
          onFieldChange(field, value);
          console.log(`✅ onFieldChange llamado exitosamente para ${field}`);
        } catch (error) {
          console.error(`❌ Error en onFieldChange para ${field}:`, error);
        }
      }
    });
    
    // Actualizar estado local
    setSelectedPath(path);
    
    console.log('🎉 Selección completada exitosamente');
    
  }, [handleChangeInput, onFieldChange]);

  // 🔄 Renderizar categoría
  const renderCategoryItem = useCallback((item, depth = 0, path = []) => {
    if (!item || !item.name) {
      console.warn('⚠️ Item inválido en renderCategoryItem');
      return null;
    }
    
    const currentPath = [...path, item];
    const isExpanded = expandedItems[item._id];
    const isSelected = selectedPath.some(p => p._id === item._id);
    const hasChildren = item.children && item.children.length > 0;

    return (
      <div key={item._id} className="category-node">
        <motion.div
          className={`category-card ${isSelected ? 'selected' : ''}`}
          style={{ marginLeft: `${depth * 16}px` }}
          whileHover={{ scale: 1.01 }}
          whileTap={{ scale: 0.99 }}
        >
          <div
            className="category-header"
            onClick={() => !disabled && handleCategoryClick(item, path)}
            style={{ cursor: disabled ? 'not-allowed' : 'pointer' }}
          >
            <div className="category-left">
              <div className="category-emoji">
                {item.emoji || (hasChildren ? '📁' : '📄')}
              </div>
              
              <div className="category-name">
                {item.name}
                {isMobile && hasChildren && (
                  <span className="mobile-badge">{item.children.length}</span>
                )}
              </div>
            </div>
            
            <div className="category-right">
              {hasChildren && (
                <motion.div
                  className="expand-arrow"
                  animate={{ rotate: isExpanded ? 90 : 0 }}
                  transition={{ duration: 0.2 }}
                >
                  <span>›</span>
                </motion.div>
              )}
              
              {isSelected && !hasChildren && (
                <div className="check-indicator">
                  <span>✓</span>
                </div>
              )}
            </div>
          </div>
        </motion.div>

        <AnimatePresence>
          {hasChildren && isExpanded && (
            <motion.div
              className="subcategories-wrapper"
              initial={{ opacity: 0, height: 0 }}
              animate={{ opacity: 1, height: 'auto' }}
              exit={{ opacity: 0, height: 0 }}
              transition={{ duration: 0.2 }}
            >
              {item.children.map(child => 
                renderCategoryItem(child, depth + 1, currentPath)
              )}
            </motion.div>
          )}
        </AnimatePresence>
      </div>
    );
  }, [disabled, expandedItems, selectedPath, handleCategoryClick, isMobile]);

  // 🔄 Filtrar categorías por búsqueda
  const filteredCategories = useMemo(() => {
    if (!searchTerm.trim()) return accordionCategories;
    
    const search = searchTerm.toLowerCase();
    const filterRecursive = (items) => {
      return items.filter(item => {
        const matches = item.name.toLowerCase().includes(search);
        const childMatches = item.children ? filterRecursive(item.children) : [];
        
        if (matches || childMatches.length > 0) {
          if (matches && item._id) {
            setExpandedItems(prev => ({ ...prev, [item._id]: true }));
          }
          return true;
        }
        return false;
      });
    };
    
    return filterRecursive(accordionCategories);
  }, [accordionCategories, searchTerm]);

  // 🔄 Estados de carga
  if (accordionLoading && accordionCategories.length === 0) {
    return (
      <div className="text-center py-4">
        <Spinner animation="border" />
        <p className="mt-2">Cargando categorías...</p>
        <small className="text-muted">Espere por favor</small>
      </div>
    );
  }

  if (accordionError) {
    return (
      <Alert variant="danger">
        <i className="fas fa-exclamation-triangle me-2"></i>
        <strong>Error:</strong> {accordionError}
        <div className="mt-2">
          <Button 
            size="sm" 
            variant="outline-primary"
            onClick={() => dispatch(getCategoriesForAccordion())}
          >
            Reintentar
          </Button>
        </div>
      </Alert>
    );
  }

  if (accordionCategories.length === 0 && !accordionLoading) {
    return (
      <Card className="text-center py-4">
        <div className="empty-icon">📭</div>
        <h5>No hay categorías disponibles</h5>
        <p className="text-muted mb-3">La base de datos no devolvió categorías</p>
        <div className="d-flex gap-2 justify-content-center">
          <Button 
            variant="primary"
            onClick={() => dispatch(getCategoriesForAccordion())}
          >
            <i className="fas fa-sync-alt me-1"></i> Cargar Categorías
          </Button>
          <Button 
            variant="outline-secondary"
            onClick={() => console.log('Estado Redux:', { 
              accordionCategories, 
              accordionLoading, 
              accordionError 
            })}
          >
            <i className="fas fa-bug me-1"></i> Debug
          </Button>
        </div>
      </Card>
    );
  }

  return (
    <div className="category-accordion">
      {/* BARRA DE BÚSQUEDA */}
      <div className="search-bar mb-3">
        <div className="input-group">
          <span className="input-group-text">
            <i className="fas fa-search"></i>
          </span>
          <input
            type="text"
            placeholder="Buscar categorías..."
            value={searchTerm}
            onChange={(e) => setSearchTerm(e.target.value)}
            disabled={disabled || accordionLoading}
            className="form-control"
          />
          {searchTerm && (
            <button 
              className="btn btn-outline-secondary"
              onClick={() => setSearchTerm('')}
              type="button"
            >
              <i className="fas fa-times"></i>
            </button>
          )}
        </div>
      </div>

      {/* RUTA SELECCIONADA */}
      {selectedPath.length > 0 && (
        <div className="selected-path mb-3 p-3 bg-light rounded">
          <div className="d-flex justify-content-between align-items-center mb-1">
            <small className="text-muted">
              <i className="fas fa-check-circle text-success me-1"></i>
              Seleccionado:
            </small>
            <button 
              className="btn btn-sm btn-outline-danger"
              onClick={() => {
                setSelectedPath([]);
                setExpandedItems({});
                // También limpiar en el padre
                if (handleChangeInput) {
                  ['categorie', 'subCategory', 'articleType'].forEach(field => {
                    handleChangeInput({ target: { name: field, value: '' } });
                  });
                }
              }}
            >
              <i className="fas fa-times me-1"></i> Limpiar
            </button>
          </div>
          <div className="d-flex align-items-center flex-wrap">
            {selectedPath.map((cat, index) => (
              <React.Fragment key={cat._id}>
                <span className="badge bg-primary me-2 mb-1">
                  {cat.emoji || '📄'} {cat.name}
                </span>
                {index < selectedPath.length - 1 && (
                  <span className="text-muted me-2">
                    <i className="fas fa-arrow-right"></i>
                  </span>
                )}
              </React.Fragment>
            ))}
          </div>
        </div>
      )}

      {/* INFO DE CATEGORÍAS */}
      <div className="category-info mb-3">
        <div className="d-flex justify-content-between align-items-center">
          <small className="text-muted">
            <i className="fas fa-folder me-1"></i>
            {accordionCategories.length} categorías disponibles
          </small>
          <small className="text-muted">
            {filteredCategories.length} filtradas
          </small>
        </div>
      </div>

      {/* LISTA DE CATEGORÍAS */}
      <div className="categories-list">
        {filteredCategories.length === 0 ? (
          <div className="text-center py-5">
            <div className="text-muted mb-3">
              <i className="fas fa-search fa-2x"></i>
            </div>
            <p>No se encontraron resultados para "<strong>{searchTerm}</strong>"</p>
            <Button 
              size="sm" 
              variant="outline-secondary"
              onClick={() => setSearchTerm('')}
            >
              <i className="fas fa-times me-1"></i> Limpiar búsqueda
            </Button>
          </div>
        ) : (
          <div>
            {filteredCategories.map(cat => renderCategoryItem(cat))}
          </div>
        )}
      </div>

      {/* INSTRUCCIONES */}
      <div className="instructions mt-3 pt-3 border-top">
        <small className="text-muted">
          <i className="fas fa-info-circle me-1"></i>
          Haz clic en una categoría para expandirla. 
          Selecciona una categoría final para continuar.
        </small>
      </div>

      {/* ESTILOS CSS */}
      <style jsx>{`
        .category-accordion {
          width: 100%;
        }
        
        .category-node {
          margin-bottom: 4px;
        }
        
        .category-card {
          background: white;
          border: 1px solid #dee2e6;
          border-radius: 8px;
          transition: all 0.2s;
        }
        
        .category-card.selected {
          border-color: #0d6efd;
          background: rgba(13, 110, 253, 0.05);
          box-shadow: 0 2px 8px rgba(13, 110, 253, 0.1);
        }
        
        .category-card:hover:not(.selected) {
          border-color: #adb5bd;
          background: #f8f9fa;
        }
        
        .category-header {
          display: flex;
          align-items: center;
          justify-content: space-between;
          padding: 12px 16px;
          user-select: none;
        }
        
        .category-left {
          display: flex;
          align-items: center;
          gap: 12px;
          flex: 1;
        }
        
        .category-emoji {
          font-size: 20px;
          width: 24px;
          text-align: center;
        }
        
        .category-name {
          font-weight: 500;
          color: #212529;
          font-size: 14px;
        }
        
        .mobile-badge {
          background: #e9ecef;
          color: #495057;
          font-size: 10px;
          padding: 1px 6px;
          border-radius: 10px;
          margin-left: 6px;
        }
        
        .category-right {
          display: flex;
          align-items: center;
          gap: 8px;
        }
        
        .expand-arrow {
          color: #6c757d;
          font-size: 16px;
          transform-origin: center;
          display: flex;
          align-items: center;
          justify-content: center;
        }
        
        .check-indicator {
          width: 20px;
          height: 20px;
          background: #0d6efd;
          border-radius: 50%;
          display: flex;
          align-items: center;
          justify-content: center;
          color: white;
          font-size: 12px;
          font-weight: bold;
        }
        
        .subcategories-wrapper {
          margin-left: 24px;
          padding-left: 16px;
          border-left: 2px dashed #dee2e6;
        }
        
        .categories-list {
          max-height: 400px;
          overflow-y: auto;
          padding: 8px;
          border: 1px solid #dee2e6;
          border-radius: 8px;
          background: #f8f9fa;
        }
        
        .instructions {
          font-size: 12px;
        }
        
        /* Scrollbar */
        .categories-list::-webkit-scrollbar {
          width: 6px;
        }
        
        .categories-list::-webkit-scrollbar-track {
          background: #f1f3f5;
          border-radius: 3px;
        }
        
        .categories-list::-webkit-scrollbar-thumb {
          background: #adb5bd;
          border-radius: 3px;
        }
        
        .categories-list::-webkit-scrollbar-thumb:hover {
          background: #6c757d;
        }
      `}</style>
    </div>
  );
};

export default CategoryAccordion;