// Componente base para inputs
const InputField = ({ fieldName, postData, handleChangeInput, label, type = "text", isRTL }) => {
  const value = postData[fieldName] || '';
  
  return (
    <div className="mb-3">
      <label className="form-label fw-semibold">
        {label}
        {value && <span className="text-success ms-1">✓</span>}
      </label>
      <input
        type={type}
        className="form-control"
        name={fieldName}
        value={value}
        onChange={handleChangeInput}
        dir={isRTL ? 'rtl' : 'ltr'}
        placeholder={`Entrez ${label.toLowerCase()}`}
      />
    </div>
  );
};

// Componente base para selects
const SelectField = ({ fieldName, postData, handleChangeInput, label, options, isRTL }) => {
  const value = postData[fieldName] || '';
  
  return (
    <div className="mb-3">
      <label className="form-label fw-semibold">
        {label}
        {value && <span className="text-success ms-1">✓</span>}
      </label>
      <select
        className="form-select"
        name={fieldName}
        value={value}
        onChange={handleChangeInput}
        dir={isRTL ? 'rtl' : 'ltr'}
      >
        <option value="">Sélectionnez {label.toLowerCase()}</option>
        {options.map(opt => (
          <option key={opt} value={opt}>{opt}</option>
        ))}
      </select>
    </div>
  );
};

// Componente base para textarea
const TextareaField = ({ fieldName, postData, handleChangeInput, label, isRTL }) => {
  const value = postData[fieldName] || '';
  
  return (
    <div className="mb-3">
      <label className="form-label fw-semibold">
        {label}
        {value && <span className="text-success ms-1">✓</span>}
      </label>
      <textarea
        className="form-control"
        name={fieldName}
        value={value}
        onChange={handleChangeInput}
        rows="3"
        dir={isRTL ? 'rtl' : 'ltr'}
        placeholder={`Décrivez ${label.toLowerCase()}`}
      />
    </div>
  );
};

/**
 * Renderizador unificado de campos
 * Este componente maneja TODOS los campos de forma centralizada
 */
const FieldRendererUnified = ({
  fieldName,
  mainCategory,
  subCategory,
  postData,
  handleChangeInput,
  isRTL,
  t
}) => {
  // Buscar componente para este campo
  const Component = FIELD_COMPONENTS[fieldName];
  
  if (!Component) {
    // Si no hay componente específico, usar InputField genérico
    console.log(`📝 Usando campo genérico para: ${fieldName}`);
    return (
      <InputField
        fieldName={fieldName}
        postData={postData}
        handleChangeInput={handleChangeInput}
        label={fieldName.charAt(0).toUpperCase() + fieldName.slice(1).replace(/([A-Z])/g, ' $1')}
        type="text"
        isRTL={isRTL}
      />
    );
  }

  // Renderizar con props estándar
  return (
    <Component
      fieldName={fieldName}
      postData={postData}
      handleChangeInput={handleChangeInput}
      isRTL={isRTL}
      t={t}
    />
  );
};

export default FieldRendererUnified;