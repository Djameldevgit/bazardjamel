// 📂 frontend/src/components/FilterDrawer.jsx - VERSIÓN CORREGIDA USANDO TU ACCIÓN EXISTENTE
import React, { useState, useEffect, useCallback } from 'react';
import { Offcanvas, Form, Button, Accordion, Spinner } from 'react-bootstrap';
import { useSelector, useDispatch } from 'react-redux';
 
import { useParams } from 'react-router-dom';
import { 
  Funnel, 
  XLg, 
  ArrowCounterclockwise,
  Check2
} from 'react-bootstrap-icons';
import Select from 'react-select';
import Slider from 'rc-slider';
import 'rc-slider/assets/index.css';
import { getCategoryPosts } from '../../redux/actions/categoryAction';

 

const FilterDrawer = ({ 
  show, 
  onHide, 
  category,
  onApplyFilters 
}) => {
 
  const dispatch = useDispatch();
  const { slug, subSlug, articleSlug } = useParams();
  const [windowWidth, setWindowWidth] = useState(window.innerWidth);
  
  // ============ ESTADO LOCAL ============
  const [categoryChildren, setCategoryChildren] = useState([]);
  const [loadingChildren, setLoadingChildren] = useState(false);
  
  // Obtener datos de Redux (por si ya están cargados)
  const categoryState = useSelector((state) => state.category);
  const { categoryInfo = {}, children = [] } = categoryState || {};

  // ============ CARGAR HIJOS USANDO TU ACCIÓN EXISTENTE ============
  useEffect(() => {
    if (!show || !slug) return;
    
    const loadChildren = async () => {
      setLoadingChildren(true);
      try {
        console.log('🔄 Cargando hijos para categoría:', slug);
        
        // 📌 USAR LA ACCIÓN EXISTENTE getCategoryPosts
        // Esta acción ya devuelve los children en data.children
        const result = await dispatch(getCategoryPosts(slug, null, null, 1, 1));
        
        console.log('✅ Resultado de getCategoryPosts:', result);
        
        // Los hijos vienen en result.children
        if (result && result.children && result.children.length > 0) {
          console.log('🎯 Hijos encontrados:', result.children.length);
          setCategoryChildren(result.children);
        } else {
          console.log('⚠️ No se encontraron hijos');
          setCategoryChildren([]);
        }
        
      } catch (error) {
        console.error('❌ Error cargando hijos:', error);
        setCategoryChildren([]);
      } finally {
        setLoadingChildren(false);
      }
    };
    
    loadChildren();
  }, [show, slug, dispatch]);

  // ============ TAMBIÉN PODEMOS USAR LOS HIJOS DE REDUX SI YA EXISTEN ============
  useEffect(() => {
    if (children && children.length > 0 && categoryChildren.length === 0) {
      console.log('📦 Usando hijos ya existentes en Redux:', children.length);
      setCategoryChildren(children);
    }
  }, [children]);

  // ============ FUNCIÓN PARA ENCONTRAR IDs POR SLUG ============
  const findIdsFromSlugs = useCallback(() => {
    let subId = '';
    let articleId = '';
    
    console.log('🔍 Buscando IDs para:', { subSlug, articleSlug });
    console.log('📚 categoryChildren:', categoryChildren);
    
    if (!categoryChildren || categoryChildren.length === 0) {
      console.log('❌ No hay children disponibles');
      return { subId, articleId };
    }
    
    // Buscar subcategoría por slug
    if (subSlug) {
      const subCategory = categoryChildren.find(
        sub => sub.slug === subSlug
      );
      
      if (subCategory) {
        subId = subCategory._id;
        console.log('✅ Subcategoría encontrada:', subCategory.name);
        
        // Buscar artículo por slug
        if (articleSlug && subCategory.articles) {
          const article = subCategory.articles.find(
            art => art.slug === articleSlug
          );
          if (article) {
            articleId = article._id;
            console.log('✅ Artículo encontrado:', article.name);
          }
        }
      }
    }
    
    return { subId, articleId };
  }, [categoryChildren, subSlug, articleSlug]);

  // ============ INICIALIZAR FILTROS DESDE URL ============
  const getInitialFilters = () => {
    const { subId, articleId } = findIdsFromSlugs();
    
    return {
      subCategory: subId || '',
      article: articleId || '',
      wilaya: '',
      commune: '',
      priceMin: '',
      priceMax: '',
      sortBy: 'recent'
    };
  };

  // Estados del filtro
  const [tempFilters, setTempFilters] = useState(getInitialFilters());
  const [priceRange, setPriceRange] = useState([0, 1000000]);
  const [wilayas, setWilayas] = useState([]);
  const [loadingWilayas, setLoadingWilayas] = useState(false);

  // ============ ACTUALIZAR CUANDO CAMBIA LA URL ============
  useEffect(() => {
    console.log('🔄 URL cambió, actualizando filtros');
    const newFilters = getInitialFilters();
    setTempFilters(newFilters);
  }, [subSlug, articleSlug, categoryChildren]);

  // Detectar tamaño de pantalla
  useEffect(() => {
    const handleResize = () => setWindowWidth(window.innerWidth);
    window.addEventListener('resize', handleResize);
    return () => window.removeEventListener('resize', handleResize);
  }, []);

  // Cargar wilayas
  useEffect(() => {
    const loadWilayas = async () => {
      setLoadingWilayas(true);
      try {
        const wilayasList = [
          { value: 'Adrar', label: 'Adrar' },
          { value: 'Chlef', label: 'Chlef' },
          { value: 'Laghouat', label: 'Laghouat' },
          { value: 'Oum El Bouaghi', label: 'Oum El Bouaghi' },
          { value: 'Batna', label: 'Batna' },
          { value: 'Béjaïa', label: 'Béjaïa' },
          { value: 'Biskra', label: 'Biskra' },
          { value: 'Béchar', label: 'Béchar' },
          { value: 'Blida', label: 'Blida' },
          { value: 'Bouira', label: 'Bouira' },
          { value: 'Tamanrasset', label: 'Tamanrasset' },
          { value: 'Tébessa', label: 'Tébessa' },
          { value: 'Tlemcen', label: 'Tlemcen' },
          { value: 'Tiaret', label: 'Tiaret' },
          { value: 'Tizi Ouzou', label: 'Tizi Ouzou' },
          { value: 'Alger', label: 'Alger' },
          { value: 'Djelfa', label: 'Djelfa' },
          { value: 'Jijel', label: 'Jijel' },
          { value: 'Sétif', label: 'Sétif' },
          { value: 'Saïda', label: 'Saïda' },
          { value: 'Skikda', label: 'Skikda' },
          { value: 'Sidi Bel Abbès', label: 'Sidi Bel Abbès' },
          { value: 'Annaba', label: 'Annaba' },
          { value: 'Guelma', label: 'Guelma' },
          { value: 'Constantine', label: 'Constantine' },
          { value: 'Médéa', label: 'Médéa' },
          { value: 'Mostaganem', label: 'Mostaganem' },
          { value: 'M\'Sila', label: 'M\'Sila' },
          { value: 'Mascara', label: 'Mascara' },
          { value: 'Ouargla', label: 'Ouargla' },
          { value: 'Oran', label: 'Oran' },
          { value: 'El Bayadh', label: 'El Bayadh' },
          { value: 'Illizi', label: 'Illizi' },
          { value: 'Bordj Bou Arréridj', label: 'Bordj Bou Arréridj' },
          { value: 'Boumerdès', label: 'Boumerdès' },
          { value: 'El Tarf', label: 'El Tarf' },
          { value: 'Tindouf', label: 'Tindouf' },
          { value: 'Tissemsilt', label: 'Tissemsilt' },
          { value: 'El Oued', label: 'El Oued' },
          { value: 'Khenchela', label: 'Khenchela' },
          { value: 'Souk Ahras', label: 'Souk Ahras' },
          { value: 'Tipaza', label: 'Tipaza' },
          { value: 'Mila', label: 'Mila' },
          { value: 'Aïn Defla', label: 'Aïn Defla' },
          { value: 'Naâma', label: 'Naâma' },
          { value: 'Aïn Témouchent', label: 'Aïn Témouchent' },
          { value: 'Ghardaïa', label: 'Ghardaïa' },
          { value: 'Relizane', label: 'Relizane' }
        ];
        setWilayas(wilayasList);
      } catch (error) {
        console.error('Error loading wilayas:', error);
      } finally {
        setLoadingWilayas(false);
      }
    };

    loadWilayas();
  }, []);

  const isMobile = windowWidth <= 768;

  // Opciones de ordenamiento
  const sortOptions = [
    { value: 'recent', label: 'Plus récents' },
    { value: 'price_asc', label: 'Prix croissant' },
    { value: 'price_desc', label: 'Prix décroissant' }
  ];

  // Manejar cambios en filtros
  const handleFilterChange = (key, value) => {
    setTempFilters(prev => ({ ...prev, [key]: value }));
    
    if (key === 'subCategory') {
      setTempFilters(prev => ({ ...prev, article: '' }));
    }
    
    if (key === 'wilaya') {
      setTempFilters(prev => ({ ...prev, commune: '' }));
    }
  };

  // Manejar cambio de rango de precio
  const handlePriceRangeChange = (values) => {
    setPriceRange(values);
    setTempFilters(prev => ({
      ...prev,
      priceMin: values[0],
      priceMax: values[1]
    }));
  };

  // Aplicar filtros
  const applyFilters = () => {
    console.log('🎯 Aplicando filtros:', tempFilters);
    onApplyFilters(tempFilters);
    onHide();
  };

  // Resetear filtros
  const resetFilters = () => {
    const { subId, articleId } = findIdsFromSlugs();
    setTempFilters({
      subCategory: subId || '',
      article: articleId || '',
      wilaya: '',
      commune: '',
      priceMin: '',
      priceMax: '',
      sortBy: 'recent'
    });
    setPriceRange([0, 1000000]);
  };

  // Contar filtros activos
  const countActiveFilters = () => {
    const { subId, articleId } = findIdsFromSlugs();
    let count = 0;
    
    if (tempFilters.subCategory && tempFilters.subCategory !== subId) count++;
    if (tempFilters.article && tempFilters.article !== articleId) count++;
    if (tempFilters.wilaya) count++;
    if (tempFilters.commune) count++;
    if (tempFilters.priceMin || tempFilters.priceMax) count++;
    if (tempFilters.sortBy !== 'recent') count++;
    
    return count;
  };

  // Obtener subcategorías
  const getSubCategories = () => {
    return categoryChildren || [];
  };

  // Obtener artículos de la subcategoría seleccionada
  const getArticles = () => {
    if (!tempFilters.subCategory) return [];
    
    const selectedSub = categoryChildren.find(
      sub => String(sub._id) === String(tempFilters.subCategory)
    );
    
    return selectedSub?.articles || [];
  };

  const subCategories = getSubCategories();

  // ============ RENDER ============
  if (loadingChildren) {
    return (
      <Offcanvas show={show} onHide={onHide} placement="start" style={{ width: isMobile ? '100%' : '400px' }}>
        <Offcanvas.Header closeButton>
          <Offcanvas.Title>Filtres</Offcanvas.Title>
        </Offcanvas.Header>
        <Offcanvas.Body>
          <div className="text-center py-5">
            <Spinner animation="border" variant="primary" />
            <p className="mt-3 text-muted">Chargement des catégories...</p>
          </div>
        </Offcanvas.Body>
      </Offcanvas>
    );
  }

  return (
    <Offcanvas
      show={show}
      onHide={onHide}
      placement="start"
      style={{
        width: isMobile ? '100%' : '400px',
        maxWidth: '100%'
      }}
    >
      {/* Header */}
      <div  >
        <div  >
          <Funnel size={20} color="#667eea" />
          <h6  >Filtres</h6>
          {countActiveFilters() > 0 && (
            <span  >
              {countActiveFilters()}
            </span>
          )}
        </div>
        <div  >
          {/* Indicador de URL */}
          <div  >
            <small>
              {slug}
              {subSlug && ` › ${subSlug}`}
              {articleSlug && ` › ${articleSlug}`}
            </small>
          </div>
          <button onClick={resetFilters}  >
            <ArrowCounterclockwise size={16} />
          </button>
          <button onClick={onHide}  >
            <XLg size={16} />
          </button>
        </div>
      </div>

      <Offcanvas.Body >
        {/* SUBCATEGORÍAS */}
        {subCategories.length > 0 && (
          <Accordion defaultActiveKey="0"  >
            <Accordion.Item eventKey="0">
              <Accordion.Header>
                Sous-catégories 
                <span  >{subCategories.length}</span>
              </Accordion.Header>
              <Accordion.Body>
                <Form.Select
                  value={tempFilters.subCategory}
                  onChange={(e) => handleFilterChange('subCategory', e.target.value)}
                   
                >
                  <option value="">Toutes les sous-catégories</option>
                  {subCategories.map(sub => (
                    <option key={sub._id} value={sub._id}>
                      {sub.name} {sub.postCount ? `(${sub.postCount})` : ''}
                      {sub.slug === subSlug ? ' ✓' : ''}
                    </option>
                  ))}
                </Form.Select>

                {/* Artículos */}
                {tempFilters.subCategory && getArticles().length > 0 && (
                  <>
                    <Form.Label  >
                      Articles
                      <span  >{getArticles().length}</span>
                    </Form.Label>
                    <Form.Select
                      value={tempFilters.article}
                      onChange={(e) => handleFilterChange('article', e.target.value)}
                     
                    >
                      <option value="">Tous les articles</option>
                      {getArticles().map(article => (
                        <option key={article._id} value={article._id}>
                          {article.name}
                          {article.slug === articleSlug ? ' ✓' : ''}
                        </option>
                      ))}
                    </Form.Select>
                  </>
                )}
              </Accordion.Body>
            </Accordion.Item>
          </Accordion>
        )}

        {/* LOCALISATION - (mismo código) */}
        <Accordion defaultActiveKey="1"  >
          <Accordion.Item eventKey="1">
            <Accordion.Header>Localisation</Accordion.Header>
            <Accordion.Body>
              {/* ... mismo código de localisation ... */}
            </Accordion.Body>
          </Accordion.Item>
        </Accordion>

        {/* PRIX - (mismo código) */}
        <Accordion defaultActiveKey="2" >
          <Accordion.Item eventKey="2">
            <Accordion.Header>Prix</Accordion.Header>
            <Accordion.Body>
              {/* ... mismo código de prix ... */}
            </Accordion.Body>
          </Accordion.Item>
        </Accordion>

        {/* TRI - (mismo código) */}
        <Accordion defaultActiveKey="3"  >
          <Accordion.Item eventKey="3">
            <Accordion.Header>Trier par</Accordion.Header>
            <Accordion.Body>
              {/* ... mismo código de tri ... */}
            </Accordion.Body>
          </Accordion.Item>
        </Accordion>
      </Offcanvas.Body>

      {/* Footer */}
      <div  >
        <Button variant="outline-secondary" onClick={resetFilters}  >
          Réinitialiser
        </Button>
        <Button variant="primary" onClick={applyFilters}  >
          Appliquer
        </Button>
      </div>
    </Offcanvas>
  );
};

// ... (mantén todos los styles igual)

export default FilterDrawer;