// components/Video/VideoReelItem.jsx - VERSIÓN CON ARRASTRE INTERACTIVO

import React, { useState, useRef, useEffect } from 'react';
import { useDispatch, useSelector } from 'react-redux';
import { Heart, p, Share2, MessageCircle, Volume2, VolumeX,   X } from 'lucide-react';
import { likeVideo, shareVideo } from '../../redux/actions/videoAction';

const VideoReelItem = ({ video, isActive = false, onVisibilityChange }) => {
  const dispatch = useDispatch();
  const { auth } = useSelector(state => state);
  const videoRef = useRef(null);
  const containerRef = useRef(null);
  const drawerRef = useRef(null);
  
  // Estados del video
  const [isLiked, setIsLiked] = useState(video.liked || false);
  const [likesCount, setLikesCount] = useState(video.likes?.length || 0);
  const [isMuted, setIsMuted] = useState(true);
  const [isPlaying, setIsPlaying] = useState(false);
  const [showComments, setShowComments] = useState(false);
  const [progress, setProgress] = useState(0);
  
  // 🆕 Estados para el arrastre interactivo
  const [dragOffset, setDragOffset] = useState(0);
  const [isDragging, setIsDragging] = useState(false);
  const [startY, setStartY] = useState(0);
  
  // Control de reproducción según visibilidad
  useEffect(() => {
    if (!videoRef.current) return;
    
    if (isActive && !showComments) {
      videoRef.current.play()
        .then(() => setIsPlaying(true))
        .catch(e => console.log('Auto-play bloqueado:', e));
      onVisibilityChange?.(true);
    } else if (!isActive && !showComments) {
      videoRef.current.pause();
      setIsPlaying(false);
      onVisibilityChange?.(false);
    }
  }, [isActive, showComments, onVisibilityChange]);
  
  // Tracking de progreso
  useEffect(() => {
    const videoElement = videoRef.current;
    if (!videoElement) return;
    
    const handleTimeUpdate = () => {
      if (videoElement.duration) {
        const currentProgress = (videoElement.currentTime / videoElement.duration) * 100;
        setProgress(currentProgress);
      }
    };
    
    videoElement.addEventListener('timeupdate', handleTimeUpdate);
    return () => videoElement.removeEventListener('timeupdate', handleTimeUpdate);
  }, []);
  
  // 🆕 Manejar el inicio del arrastre
  const handleDragStart = (e) => {
    const clientY = e.touches ? e.touches[0].clientY : e.clientY;
    setStartY(clientY);
    setIsDragging(true);
    setDragOffset(0);
  };
  
  // 🆕 Manejar el arrastre
  const handleDragMove = (e) => {
    if (!isDragging) return;
    
    const clientY = e.touches ? e.touches[0].clientY : e.clientY;
    let delta = clientY - startY;
    
    // Solo permitir arrastre hacia abajo (delta positivo)
    if (delta < 0) delta = 0;
    
    // Limitar el arrastre máximo al 80% de la altura
    const maxDrag = window.innerHeight * 0.8;
    const newOffset = Math.min(delta, maxDrag);
    setDragOffset(newOffset);
    
    // Actualizar posición del modal y tamaño del video en tiempo real
    if (drawerRef.current) {
      drawerRef.current.style.transform = `translateY(${newOffset}px)`;
    }
  };
  
  // 🆕 Manejar el fin del arrastre
  const handleDragEnd = () => {
    setIsDragging(false);
    
    // Si arrastró más del 30% de la pantalla, cerrar
    const threshold = window.innerHeight * 0.3;
    
    if (dragOffset > threshold) {
      // Cerrar completamente
      handleCloseComments();
    } else {
      // Volver a la posición original
      if (drawerRef.current) {
        drawerRef.current.style.transform = '';
      }
      setDragOffset(0);
    }
  };
  
  // 🆕 Calcular el tamaño del video basado en el arrastre
  const getVideoScale = () => {
    if (!showComments) return 1;
    if (!isDragging && dragOffset === 0) return 0.7;
    
    // Durante el arrastre: escala desde 0.7 hasta 1.0
    const maxDrag = window.innerHeight * 0.8;
    const progress = Math.min(dragOffset / maxDrag, 1);
    // Escala: 0.7 + (0.3 * progress) = máximo 1.0
    return 0.7 + (0.3 * progress);
  };
  
  // 🆕 Calcular la posición Y del video durante el arrastre
  const getVideoTranslateY = () => {
    if (!showComments) return 0;
    if (!isDragging && dragOffset === 0) return -15;
    
    const maxDrag = window.innerHeight * 0.8;
    const progress = Math.min(dragOffset / maxDrag, 1);
    // translateY: -15% hasta 0%
    return -15 * (1 - progress);
  };
  
  const handleLike = async () => {
    if (!auth.token) return;
    
    const result = await dispatch(likeVideo(video._id, auth.token));
    if (result) {
      setIsLiked(result.liked);
      setLikesCount(result.likes);
      
      if (result.liked) {
        createHeartEffect();
      }
    }
  };
  
  const createHeartEffect = () => {
    const heart = document.createElement('div');
    heart.className = 'floating-heart';
    heart.innerHTML = '❤️';
    document.body.appendChild(heart);
    setTimeout(() => heart.remove(), 1000);
  };
  
  const handleDoubleClick = (e) => {
    e.stopPropagation();
    if (!isLiked) {
      handleLike();
    }
  };
  
  const handleShare = async () => {
    if (!auth.token) return;
    
    const shareUrl = `${window.location.origin}/video/${video._id}`;
    
    if (navigator.share) {
      try {
        await navigator.share({
          title: video.title,
          text: video.description,
          url: shareUrl
        });
      } catch (err) {
        console.log('Error sharing:', err);
      }
    } else {
      navigator.clipboard.writeText(shareUrl);
    }
    
    await dispatch(shareVideo(video._id, auth.token));
  };
  
  const toggleMute = (e) => {
    e.stopPropagation();
    if (videoRef.current) {
      videoRef.current.muted = !isMuted;
      setIsMuted(!isMuted);
    }
  };
  
  const togglePlay = (e) => {
    e.stopPropagation();
    if (videoRef.current) {
      if (isPlaying) {
        videoRef.current.pause();
      } else {
        videoRef.current.play();
      }
      setIsPlaying(!isPlaying);
    }
  };
  
  const handleProgressClick = (e) => {
    e.stopPropagation();
    if (videoRef.current && videoRef.current.duration) {
      const rect = e.currentTarget.getBoundingClientRect();
      const pos = (e.clientX - rect.left) / rect.width;
      videoRef.current.currentTime = pos * videoRef.current.duration;
    }
  };
  
  const handleOpenComments = () => {
    setShowComments(true);
    setDragOffset(0);
  };
  
  const handleCloseComments = () => {
    setShowComments(false);
    setDragOffset(0);
    if (drawerRef.current) {
      drawerRef.current.style.transform = '';
    }
  };
  
  const formatNumber = (num) => {
    if (!num) return '0';
    if (num >= 1000000) return (num / 1000000).toFixed(1) + 'M';
    if (num >= 1000) return (num / 1000).toFixed(1) + 'K';
    return num.toString();
  };
  
  // Calcular estilos dinámicos durante el arrastre
  const videoScale = getVideoScale();
  const videoTranslateY = getVideoTranslateY();
  
  return (
    <div 
      ref={containerRef}
      className={`video-reel-container ${showComments ? 'comments-open' : ''}`}
      style={{
        height: '100vh',
        scrollSnapAlign: 'start',
        position: 'relative',
        backgroundColor: '#000',
        overflow: 'hidden'
      }}
    >
      {/* ============================================ */}
      {/* EL MISMO VIDEO - con animación DINÁMICA durante arrastre */}
      {/* ============================================ */}
      <div 
        className={`video-main-wrapper ${showComments ? 'compact' : 'fullscreen'}`}
        style={{
          transform: showComments 
            ? `scale(${videoScale}) translateY(${videoTranslateY}%)`
            : 'scale(1) translateY(0)',
          transformOrigin: 'top center',
          transition: isDragging ? 'none' : 'all 0.3s cubic-bezier(0.2, 0.9, 0.4, 1.1)',
          width: showComments ? '70%' : '100%',
          left: showComments ? '50%' : '0',
          marginLeft: showComments ? '-35%' : '0',
          top: showComments ? '20px' : '0',
          borderRadius: showComments ? '16px' : '0',
          boxShadow: showComments ? '0 8px 32px rgba(0, 0, 0, 0.4)' : 'none',
          position: showComments ? 'absolute' : 'relative',
          cursor: showComments ? 'pointer' : 'default'
        }}
      >
        {/* Video element */}
        <video
          ref={videoRef}
          src={video.videoUrl}
          loop
          muted={isMuted}
          playsInline
          className="reel-video"
          onClick={togglePlay}
          onDoubleClick={handleDoubleClick}
          poster={video.thumbnail}
          style={{
            borderRadius: showComments ? '12px' : '0'
          }}
        />
        
        {/* Barra de progreso */}
        {!showComments && (
          <div className="progress-bar" onClick={handleProgressClick}>
            <div className="progress-fill" style={{ width: `${progress}%` }} />
          </div>
        )}
        
        {/* Control de volumen */}
        {!showComments && (
          <button className="volume-control" onClick={toggleMute}>
            {isMuted ? <VolumeX size={20} /> : <Volume2 size={20} />}
          </button>
        )}
        
        {/* Sidebar de acciones (derecha) */}
        {!showComments && (
          <div className="actions-sidebar">
            <button className="action-btn" onClick={handleLike}>
              {isLiked ? <p size={32} color="#ff4040" /> : <Heart size={32} />}
              <span>{formatNumber(likesCount)}</span>
            </button>
            
            <button className="action-btn" onClick={handleOpenComments}>
              <MessageCircle size={32} />
              <span>{formatNumber(video.comments?.length || 0)}</span>
            </button>
            
            <button className="action-btn" onClick={handleShare}>
              <Share2 size={32} />
              <span>Partager</span>
            </button>
          </div>
        )}
        
        {/* Información del video (abajo izquierda) */}
        {!showComments && (
          <div className="video-info">
            <div className="user-info">
              <img
                src={video.user?.avatar || '/default-avatar.png'}
                alt={video.user?.username}
                className="user-avatar"
              />
              <div>
                <strong className="username">@{video.user?.username}</strong>
                <div className="video-stats">
                  <span>{formatNumber(video.views)} vues</span>
                  <span>•</span>
                  <span>{formatNumber(video.likes?.length || 0)} likes</span>
                </div>
              </div>
              <button className="follow-btn">Suivre</button>
            </div>
            <p className="description">{video.description}</p>
            <div className="music-info">
              <p size={14} />
              <span>{video.title}</span>
            </div>
          </div>
        )}
      </div>
      
      {/* ============================================ */}
      {/* MODAL DE COMENTARIOS CON ARRASTRE INTERACTIVO */}
      {/* ============================================ */}
      <div className={`comments-modal ${showComments ? 'open' : ''}`}>
        <div 
          ref={drawerRef}
          className="comments-drawer"
          onTouchStart={handleDragStart}
          onTouchMove={handleDragMove}
          onTouchEnd={handleDragEnd}
          onMouseDown={handleDragStart}
          onMouseMove={handleDragMove}
          onMouseUp={handleDragEnd}
          onMouseLeave={handleDragEnd}
          style={{
            transition: isDragging ? 'none' : 'transform 0.3s cubic-bezier(0.2, 0.9, 0.4, 1.1)'
          }}
        >
          {/* Handle para arrastrar */}
          <div className="drawer-handle">
            <div className="handle-bar" />
          </div>
          
          {/* Header */}
          <div className="drawer-header">
            <h5>{video.comments?.length || 0} commentaires</h5>
            <button className="close-btn" onClick={handleCloseComments}>
              <X size={24} />
            </button>
          </div>
          
          {/* Lista de comentarios */}
          <div className="comments-list">
            <p style={{ color: '#888', textAlign: 'center', padding: '20px' }}>
              Componente VideoComments aquí
            </p>
          </div>
        </div>
      </div>
      
      {/* ============================================ */}
      {/* ESTILOS CSS */}
      {/* ============================================ */}
      <style jsx="true">{`
        .video-reel-container {
          position: relative;
          width: 100%;
          height: 100vh;
          overflow: hidden;
        }
        
        .reel-video {
          width: 100%;
          height: 100%;
          object-fit: contain;
        }
        
        /* Barra de progreso */
        .progress-bar {
          position: absolute;
          bottom: 0;
          left: 0;
          right: 0;
          height: 3px;
          background: rgba(255, 255, 255, 0.3);
          cursor: pointer;
          z-index: 20;
        }
        
        .progress-fill {
          height: 100%;
          background: #ff4040;
          transition: width 0.1s linear;
        }
        
        /* Control de volumen */
        .volume-control {
          position: absolute;
          bottom: 20px;
          right: 20px;
          background: rgba(0, 0, 0, 0.5);
          border: none;
          border-radius: 50%;
          width: 40px;
          height: 40px;
          display: flex;
          align-items: center;
          justify-content: center;
          color: white;
          cursor: pointer;
          z-index: 20;
          backdrop-filter: blur(4px);
        }
        
        /* Sidebar de acciones */
        .actions-sidebar {
          position: absolute;
          right: 16px;
          bottom: 100px;
          display: flex;
          flex-direction: column;
          gap: 24px;
          z-index: 20;
        }
        
        .action-btn {
          background: none;
          border: none;
          color: white;
          display: flex;
          flex-direction: column;
          align-items: center;
          gap: 4px;
          cursor: pointer;
          text-shadow: 0 1px 2px rgba(0, 0, 0, 0.5);
          transition: transform 0.2s ease;
        }
        
        .action-btn:hover {
          transform: scale(1.05);
        }
        
        .action-btn span {
          font-size: 12px;
          font-weight: 500;
        }
        
        /* Información del video */
        .video-info {
          position: absolute;
          left: 16px;
          bottom: 80px;
          color: white;
          z-index: 20;
          max-width: 60%;
        }
        
        .user-info {
          display: flex;
          align-items: center;
          gap: 12px;
          margin-bottom: 8px;
        }
        
        .user-avatar {
          width: 48px;
          height: 48px;
          border-radius: 50%;
          border: 2px solid white;
          cursor: pointer;
        }
        
        .username {
          font-size: 16px;
          cursor: pointer;
        }
        
        .username:hover {
          text-decoration: underline;
        }
        
        .video-stats {
          display: flex;
          gap: 8px;
          font-size: 12px;
          opacity: 0.8;
        }
        
        .follow-btn {
          background: #ff4040;
          border: none;
          color: white;
          padding: 6px 16px;
          border-radius: 20px;
          font-size: 13px;
          font-weight: 600;
          cursor: pointer;
          transition: opacity 0.2s ease;
        }
        
        .follow-btn:hover {
          opacity: 0.9;
        }
        
        .description {
          font-size: 14px;
          margin-bottom: 8px;
          display: -webkit-box;
          -webkit-line-clamp: 2;
          -webkit-box-orient: vertical;
          overflow: hidden;
        }
        
        .music-info {
          display: flex;
          align-items: center;
          gap: 6px;
          font-size: 12px;
          opacity: 0.8;
        }
        
        /* Modal de comentarios */
        .comments-modal {
          position: fixed;
          top: 0;
          left: 0;
          right: 0;
          bottom: 0;
          z-index: 1000;
          display: flex;
          flex-direction: column;
          justify-content: flex-end;
          pointer-events: none;
        }
        
        .comments-modal.open {
          pointer-events: auto;
        }
        
        .comments-drawer {
          background: #121212;
          border-radius: 20px 20px 0 0;
          height: 55vh;
          display: flex;
          flex-direction: column;
          transform: translateY(100%);
          cursor: grab;
        }
        
        .comments-drawer:active {
          cursor: grabbing;
        }
        
        .comments-modal.open .comments-drawer {
          transform: translateY(0);
        }
        
        .drawer-handle {
          display: flex;
          justify-content: center;
          padding: 12px 0 8px;
          cursor: pointer;
        }
        
        .handle-bar {
          width: 40px;
          height: 4px;
          background: #555;
          border-radius: 2px;
          transition: background 0.2s ease;
        }
        
        .drawer-handle:hover .handle-bar {
          background: #888;
        }
        
        .drawer-header {
          display: flex;
          justify-content: space-between;
          align-items: center;
          padding: 0 16px 12px;
          border-bottom: 1px solid #2a2a2a;
        }
        
        .drawer-header h5 {
          color: white;
          margin: 0;
          font-size: 16px;
        }
        
        .close-btn {
          background: none;
          border: none;
          color: white;
          cursor: pointer;
          padding: 8px;
          border-radius: 50%;
          transition: background 0.2s ease;
          display: flex;
          align-items: center;
          justify-content: center;
        }
        
        .close-btn:hover {
          background: rgba(255, 255, 255, 0.1);
        }
        
        .comments-list {
          flex: 1;
          overflow-y: auto;
          padding: 16px;
        }
        
        /* Animaciones */
        .floating-heart {
          position: fixed;
          left: 50%;
          top: 50%;
          transform: translate(-50%, -50%);
          font-size: 64px;
          animation: floatUp 0.6s ease-out forwards;
          pointer-events: none;
          z-index: 1000;
        }
        
        @keyframes floatUp {
          0% {
            opacity: 1;
            transform: translate(-50%, -50%) scale(0.5);
          }
          100% {
            opacity: 0;
            transform: translate(-50%, -150%) scale(1.5);
          }
        }
        
        /* Scrollbar */
        .comments-list::-webkit-scrollbar {
          width: 4px;
        }
        
        .comments-list::-webkit-scrollbar-track {
          background: #1a1a1a;
        }
        
        .comments-list::-webkit-scrollbar-thumb {
          background: #555;
          border-radius: 4px;
        }
        
        /* Responsive */
        @media (max-width: 768px) {
          .video-main-wrapper.compact {
            width: 65%;
            margin-left: -32.5%;
          }
          
          .comments-drawer {
            height: 60vh;
          }
        }
      `}</style>
    </div>
  );
};

export default VideoReelItem;