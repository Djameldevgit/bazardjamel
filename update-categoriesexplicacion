 // ejecutar node scripts/update-categories.js
Solo editas las secciones en updates:
 Recuerda:

Siempre haz backup antes de modificar:

 
npm run backup-categories
Prueba primero con disable antes de delete para evitar pérdidas accidentales

Los slugs son la clave - asegúrate de escribirlos exactamente como están en la base de datos

Estaré por aquí cuando necesites ayuda con las actualizaciones. ¡Éxito con tu marketplace! 🚀


const updates = {
  // PARA AGREGAR
  addCategories: [
    {
      name: 'Nueva Categoría',
      slug: 'nueva-categoria',
      parentSlug: 'vehicules',  // Slug del padre (opcional, si es nivel 1 no poner)
      icon: '/categories/ruta/icono.png',
      order: 1,
      children: []  // Subcategorías si tiene
    }
  ],

  // PARA ACTUALIZAR (URL, icono, nombre, etc)
  updateCategories: [
    {
      findSlug: 'voitures',
      updates: {
        icon: '/categories/vehicules/nuevo-icono.png',
        order: 1,
        name: 'Automóviles'  // opcional
      }
    }
  ],

  // PARA DESHABILITAR (ocultar)
  disableCategories: [
    { slug: 'boutiques' },
    { slug: 'voyages' }
  ],

  // PARA ACTIVAR (mostrar de nuevo)
  activateCategories: [
    { slug: 'boutiques' }
  ],

  // PARA ELIMINAR PERMANENTEMENTE (cuidado)
  deleteCategories: [
    { slug: 'categoria-obsoleta' }
  ],

  // PARA REORDENAR
  reorderCategoriesList: [
    {
      parentSlug: null,  // null = categorías principales
      orderedSlugs: ['boutiques', 'immobilier', 'vehicules']
    }
  ],

  // PARA MOVER A OTRO PADRE
  moveCategories: [
    {
      slug: 'coches-electricos',
      newParentSlug: 'voitures'
    }
  ]
};
Reglas:
Agregar: Pones la categoría nueva

Deshabilitar: Pones el slug en disableCategories

Activar: Pones el slug en activateCategories

Eliminar: Pones el slug en deleteCategories