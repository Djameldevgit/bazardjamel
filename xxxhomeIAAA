    const ahora = Date.now();
  
    // 🔹 Caché solo para nivel 1 sin posts
    if (!incluirPosts && cacheCategoriasPrincipales && ahora - cacheCategoriasPrincipalesEn < 5 * 60 * 1000) {
      return res.json(cacheCategoriasPrincipales);
