// 📂 pages/CreateAnnoncePage.js - AGREGAR ESTA FUNCIÓN
const extractCategoryFromId = useCallback((categoryId, categories) => {
  if (!categoryId || !categories) {
    return { categorie: '', subCategory: '', articleType: '' };
  }
  
  // Buscar la categoría por ID
  const found = findCategoryById(categories, categoryId);
  
  if (!found) {
    console.warn('❌ Categoría no encontrada por ID:', categoryId);
    return { categorie: '', subCategory: '', articleType: '' };
  }
  
  // Extraer los niveles de la ruta
  const { path } = found;
  console.log('📍 Ruta encontrada:', path);
  
  // Asignar según la longitud de la ruta
  if (path.length >= 3) {
    return {
      categorie: path[0],
      subCategory: path[1],
      articleType: path[2]
    };
  } else if (path.length === 2) {
    return {
      categorie: path[0],
      subCategory: path[1],
      articleType: ''
    };
  } else if (path.length === 1) {
    return {
      categorie: path[0],
      subCategory: '',
      articleType: ''
    };
  }
  
  return { categorie: '', subCategory: '', articleType: '' };
}, [findCategoryById]);
