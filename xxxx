// 📂 backend - En tu controlador de posts
const getPostWithCategory = async (postId) => {
  const post = await Post.findById(postId)
    .populate({
      path: 'category',
      select: 'slug name parent',
      populate: {
        path: 'parent',
        select: 'slug name parent',
        populate: {
          path: 'parent',
          select: 'slug name'
        }
      }
    });
  
  if (post.category) {
    // Extraer la jerarquía completa
    const hierarchy = [];
    let current = post.category;
    
    while (current) {
      hierarchy.unshift(current.slug || current.name);
      current = current.parent;
    }
    
    // Agregar al post para fácil acceso en frontend
    post.categoryHierarchy = hierarchy;
    
    if (hierarchy.length >= 1) post.categorie = hierarchy[0];
    if (hierarchy.length >= 2) post.subCategory = hierarchy[1];
    if (hierarchy.length >= 3) post.articleType = hierarchy[2];
  }
  
  return post;
};
