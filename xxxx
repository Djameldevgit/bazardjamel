// redux/actions/categoryAction.js
export const getAllCategoriesWithPosts = (page=1, limit=8) => async (dispatch) => {
  dispatch({ type: 'GET_ALL_CATEGORIES_WITH_POSTS' });
  const { data } = await axios.get('/api/categories/main', {
    params: { page, limit, posts: true }
  });
  dispatch({ type: 'GET_ALL_CATEGORIES_WITH_POSTS_SUCCESS', payload: data });
};


↓

