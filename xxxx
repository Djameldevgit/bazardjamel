// asignar a nivel3, luego agregar a nivel2 y nivel1 (limitar a 8)
nivel3.forEach(c => c.posts = postsMap[String(c._id)] || []);
nivel2.forEach(c => c.posts = [...(postsMap[String(c._id)]||[]), ...c.children.flatMap(ch=>ch.posts||[])].slice(0,8));
nivel1.forEach(c => c.posts = [...(postsMap[String(c._id)]||[]), ...c.children.flatMap(ch=>ch.posts||[])].slice(0,8));


