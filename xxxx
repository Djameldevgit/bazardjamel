2. Función para buscar categoría por ID recursivamente
javascript
// 📂 pages/CreateAnnoncePage.js - AGREGAR ESTA FUNCIÓN
const findCategoryById = useCallback((categories, idToFind, path = []) => {
  if (!categories || !Array.isArray(categories)) return null;
  
  for (const category of categories) {
    // Verificar si esta categoría coincide
    if (category._id === idToFind) {
      return {
        categorie: category.slug || category.name,
        path: [...path, category.slug || category.name]
      };
    }
    
    // Buscar en subcategorías
    if (category.subcategories && category.subcategories.length > 0) {
      const result = findCategoryById(category.subcategories, idToFind, [
        ...path, 
        category.slug || category.name
      ]);
      if (result) return result;
    }
    
    // Buscar en articleTypes
    if (category.articleTypes && category.articleTypes.length > 0) {
      const result = findCategoryById(category.articleTypes, idToFind, [
        ...path, 
        category.slug || category.name
      ]);
      if (result) return result;
    }
  }
  
  return null;
}, []);
