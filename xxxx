  const loadCategories = async () => {
    try {
      setCategoriesLoading(true);
      
      // Intentar obtener categorías del estado global primero
      const categoriesFromState = useSelector(state => state.categories);
      
      if (categoriesFromState && categoriesFromState.categoriesList) {
        console.log('📂 Categorías desde estado global:', categoriesFromState.categoriesList.length);
        setCategoriesList(categoriesFromState.categoriesList);
      } else {
        // Si no hay en estado global, cargar desde API
        const result = await dispatch(getAllCategories());
        if (result?.payload?.categories) {
          console.log('📂 Categorías cargadas desde API:', result.payload.categories.length);
          setCategoriesList(result.payload.categories);
        }
      }
    } catch (error) {
      console.error('❌ Error al cargar categorías:', error);
    } finally {
      setCategoriesLoading(false);
    }
  };
  
  loadCategories();
}, [dispatch]);
